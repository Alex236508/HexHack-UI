{
  "manifest_version": 3,
  "name": "HexHack-UI",
  "version": "1.0.0",
  "description": "HexHack-UI browser extension",

  "action": {
    "default_title": "HexHack-UI"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["UI.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "host_permissions": [
    "<all_urls>"
  ]
}
